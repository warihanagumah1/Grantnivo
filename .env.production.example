# Copy to .env on the server; replace all CHANGE_ME values before running Artisan.
APP_NAME=Grantnivo
APP_ENV=production
APP_KEY=CHANGE_ME_EXISTING_APP_KEY
APP_DEBUG=false
APP_URL=https://CHANGE_ME_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grantnivo
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
OPPORTUNITY_IMAGES_DISK=r2
# R2 S3 credentials belong in the host's secrets, never in GitHub source.
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_BUCKET=CHANGE_ME_R2_BUCKET
R2_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# Public image domain connected to this bucket (not the S3 API endpoint).
R2_PUBLIC_URL=https://CHANGE_ME_IMAGE_DOMAIN
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=240
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME_MAIL_HOST
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_MAIL_USER
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_FROM_ADDRESS
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Confirmed operator details; legal review status is separate.
LEGAL_OPERATOR=WAMEER
LEGAL_COUNTRY=Ghana
LEGAL_ADDRESS="PMB CT 3, Cantonments, Accra, Ghana"
PRIVACY_CONTACT_EMAIL=support@grantnivo.com
LEGAL_POLICIES_REVIEWED=false
